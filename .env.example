# ─────────────────────────────────────────
# Nelliy's Rewards — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# ── Database ──────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/nelliy_rewards"
DIRECT_URL="postgresql://postgres:password@localhost:5432/nelliy_rewards"

# ── NextAuth ──────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Admin Panel Auth ──────────────────────
# All three are REQUIRED — no defaults in production
ADMIN_USERNAME="your-admin-username"
ADMIN_PASSWORD="your-strong-admin-password"
# Generate with: openssl rand -hex 32
ADMIN_SECRET="your-admin-secret-token"

# ── Receipt QR Security ───────────────────
# Generate with: openssl rand -hex 32
# REQUIRED — no default in production
RECEIPT_QR_SECRET="your-receipt-qr-secret"

# ── Email Service (Resend / EmailJS) ──────
# Get free API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="Nelliy's Rewards <onboarding@resend.dev>"
# Or use EmailJS:
EMAILJS_PRIVATE_KEY="your-emailjs-private-key"

# ── Cashier POS PIN ───────────────────
# PIN cashiers enter to unlock the standalone POS at /pos
POS_PIN="1234"

# ── Firebase Client (Phone Auth OTP & Messaging) ────────
# Get from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-fcm-vapid-key"

# ── Firebase Admin (Server-side verification & Push) ────
# Get from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID="your-app-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-app-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── OCR.space API (OCR for Receipts) ───────────────────
# Get free key (25k requests/mo) from https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY="your-ocr-space-api-key"

# ── Payment (Optional) ────────────────────
CHAPA_SECRET_KEY="CHASECK_TEST-your-key-here"
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-your-key-here"

# ── App Config ────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Cron Jobs ─────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"
